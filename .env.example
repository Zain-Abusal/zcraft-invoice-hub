# Shared sign-in password for the tool (server-only)
SITE_PASSWORD=change-me-to-a-long-passphrase
# 32+ random chars used to encrypt the session cookie (openssl rand -hex 32)
SESSION_SECRET=replace-with-64-random-hex-chars

# Tebex Headless API
TEBEX_PUBLIC_TOKEN=your-webstore-public-token
# Optional: project private key (enables Basic auth + passing client IP)
TEBEX_PRIVATE_KEY=
# ID of the base-unit package (e.g. "Custom commission unit" priced 1.00)
TEBEX_PACKAGE_ID=1234567
# Unit price is read directly from the Tebex package.
# Your Tebex store's currency (baskets are charged in this currency)
TEBEX_STORE_CURRENCY=USD

# Public URL of this tool (used for Tebex return URLs)
SITE_URL=https://invoice.zcraftstudios.com
